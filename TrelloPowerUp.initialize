<!-- index.html (connector) -->
<script src="https://p.trellocdn.com/power-up.min.js"></script>
<script>
  window.TrelloPowerUp.initialize({
    'card-buttons': function (t, opts) {
      return [{
        icon: 'https://SEU-USUARIO.github.io/SEU-REPO/icon.png',
        text: 'Classificar demanda',
        callback: function (t) {
          return t.popup({
            title: 'Triagem CPO',
            url: 'https://github.com/charlesglopes/powerup-cpo/triagem.html',
            height: 400
          });
        }
      }];
    }
  });
</script>
